# AI Provider API Keys (Keep secret, never expose on client)
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/veil_ai?schema=public"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
USE_MOCK_AI="true" # Set to false when API key is provided